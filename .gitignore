# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos el ejemplo, que ES documentacion: dice que variables hacen falta y no
# lleva ni un valor real. Sin esta linea, `.env*` se lo traga y quien clona el
# repo no tiene forma de saber que espera Payload.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# La base de SQLite en local. Datos, no codigo.
*.db
*.db-shm
*.db-wal
