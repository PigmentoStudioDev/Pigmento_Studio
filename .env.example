# Base de datos. En local un archivo; en produccion, Turso (libSQL remoto):
# Vercel tiene el sistema de archivos efimero y un .db local no sobrevive al deploy.
DATABASE_URI=file:./pigmento.db
DATABASE_AUTH_TOKEN=

# Cadena larga y aleatoria. Nunca la real en el repo.
PAYLOAD_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# Media en R2. Sin R2_BUCKET el plugin se apaga y Payload sirve desde disco
# local: el proyecto arranca sin credenciales.
# Las claves S3 se crean en el dashboard de Cloudflare (R2 > API > Manage API
# tokens) y el secreto se muestra UNA sola vez. wrangler no las expone.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com  # el account id sale de wrangler o del dashboard
R2_PUBLIC_URL=https://media.pigmentostudio.com.mx
